<?xml version="1.0" encoding="utf-8"?>
<!--
	The launcher background: the paper the cell is drawn on (app_icon.svg's white field).

	Not pure #FFFFFF - a flat white icon dissolves into a light wallpaper and loses its own outline. #FAFBFD
	is the same paper one step off white, which keeps the mask's silhouette readable while leaving the blue
	rules and the digits the only things with any colour in them.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
		android:width="108dp"
		android:height="108dp"
		android:viewportWidth="108"
		android:viewportHeight="108">
	<path
			android:fillColor="#FFFAFBFD"
			android:pathData="M0,0h108v108h-108z" />
</vector>
